pipeline {
    agent any

    environment {
        COMPOSE_FILE = 'docker-compose.yml'
        PROJECT_NAME = 'YoskerAiCounselling'
    }

    stages {

        stage('Clone Repository') {
            steps {
                echo '📥 Cloning GitHub repository...'
                git 'https://github.com/YOSKERnerv/-AICounselorWebsite.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "🔧 Building Docker image..."
                sh "docker build -t ${PROJECT_NAME}_image ."
            }
        }

        stage('Test Flask App') {
            steps {
                echo "🧪 Running basic Flask app test..."
                script {
                    sh "docker run -d -p 5001:5000 --name temp_test ${PROJECT_NAME}_image"
                    sh "sleep 5" // Give time for the app to start
                    sh "curl -I http://localhost:5001 || echo '⚠️ App may not have responded correctly'"
                    sh "docker stop temp_test"
                    sh "docker rm temp_test"
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                echo "Deploying using Docker Compose..."
                script {
                    sh 'docker-compose down || true'
                    sh 'docker-compose up -d --build'
                }
            }
        }
    }

    post {
        always {
            echo '✅ Pipeline finished.'
        }
        success {
            echo '🎉 CI/CD Pipeline completed successfully.'
        }
        failure {
            echo '❌ CI/CD Pipeline failed.'
        }
    }
}
